#!/usr/bin/env bash
set -u

# Git may invoke hooks from a GUI without the shell initialization that adds
# mise-managed tools to PATH.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

workflow_files=()
dockerfiles=()
toml_files=()
markdown_files=()
commented_files=()

while IFS= read -r -d '' file_path; do
  case "$file_path" in
  .github/workflows/*.yml | .github/workflows/*.yaml)
    workflow_files+=("$file_path")
    ;;
  esac

  case "$file_path" in
  Dockerfile | */Dockerfile | *.Dockerfile)
    dockerfiles+=("$file_path")
    ;;
  esac

  case "$file_path" in
  *.toml)
    toml_files+=("$file_path")
    ;;
  esac

  case "$file_path" in
  *.md)
    markdown_files+=("$file_path")
    ;;
  esac

  case "$file_path" in
  *.sh | *.rs)
    commented_files+=("$file_path")
    ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

status=0

if ((${#workflow_files[@]} > 0)); then
  echo "Checking staged GitHub Actions workflows..."

  # Keep release-update checks out of pre-commit; they are network-dependent and
  # belong in Dependabot, Renovate, or scheduled CI.
  if ! pinact run --check --verify-comment "${workflow_files[@]}"; then
    status=1
  fi

  if ! actionlint "${workflow_files[@]}"; then
    status=1
  fi

  if ! zizmor --no-progress "${workflow_files[@]}"; then
    status=1
  fi
fi

if ((${#dockerfiles[@]} > 0)); then
  echo "Checking staged Dockerfiles..."

  if ! hadolint "${dockerfiles[@]}"; then
    status=1
  fi
fi

if ((${#toml_files[@]} > 0)); then
  echo "Checking staged TOML files..."

  if ! tombi lint "${toml_files[@]}"; then
    status=1
  fi

  if ! tombi format --check --diff "${toml_files[@]}"; then
    status=1
  fi
fi

if ((${#markdown_files[@]} > 0)); then
  echo "Checking staged Markdown files (added/changed lines only)..."

  # textlint は絶対パスで報告するため、diff 側の相対パスに合わせて剥がす
  repo_root=$(git rev-parse --show-toplevel)
  checkstyle_output=$(textlint-ja -f checkstyle "${markdown_files[@]}")
  textlint_status=$?

  if ((textlint_status != 0)) && [[ -z "$checkstyle_output" ]]; then
    # 出力が空なのに失敗している場合は違反ではなく textlint 自体の実行失敗
    status=1
  elif ! printf '%s\n' "$checkstyle_output" \
    | sed "s#${repo_root}/##g" \
    | reviewdog -f=checkstyle -diff="git diff --cached" -filter-mode=added -fail-level=error; then
    status=1
  fi
fi

if ((${#commented_files[@]} > 0)); then
  echo "Checking staged code comments..."

  if ! textlint-comments "${commented_files[@]}"; then
    status=1
  fi
fi

exit "$status"
