#!/usr/bin/env bash
set -u

# Git may invoke hooks from a GUI without the shell initialization that adds
# mise-managed tools to PATH.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

workflow_files=()
dockerfiles=()
toml_files=()
markdown_files=()
commented_files=()

# .hadolint.yaml はパス単位の除外を持たず、除外設定をコミットせずに済ませたいので
# リポジトリごとの .git/info/hadolint-ignore（1 行 1 glob）で除外する
hadolint_ignore_patterns=()
hadolint_ignore_file=$(git rev-parse --git-path info/hadolint-ignore)
if [[ -f "$hadolint_ignore_file" ]]; then
  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    [[ -z "$pattern" || "$pattern" == \#* ]] && continue
    hadolint_ignore_patterns+=("$pattern")
  done <"$hadolint_ignore_file"
fi

is_hadolint_ignored() {
  local pattern
  for pattern in ${hadolint_ignore_patterns[@]+"${hadolint_ignore_patterns[@]}"}; do
    # shellcheck disable=SC2053
    [[ "$1" == $pattern ]] && return 0
  done
  return 1
}

while IFS= read -r -d '' file_path; do
  case "$file_path" in
  .github/workflows/*.yml | .github/workflows/*.yaml)
    workflow_files+=("$file_path")
    ;;
  esac

  case "$file_path" in
  Dockerfile | */Dockerfile | *.Dockerfile)
    is_hadolint_ignored "$file_path" || dockerfiles+=("$file_path")
    ;;
  esac

  case "$file_path" in
  *.toml)
    toml_files+=("$file_path")
    ;;
  esac

  case "$file_path" in
  *.md)
    markdown_files+=("$file_path")
    ;;
  esac

  case "$file_path" in
  *.sh | *.rs)
    commented_files+=("$file_path")
    ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

status=0

if ((${#workflow_files[@]} > 0)); then
  echo "Checking staged GitHub Actions workflows..."

  # Keep release-update checks out of pre-commit; they are network-dependent and
  # belong in Dependabot, Renovate, or scheduled CI.
  if ! pinact run --check --verify-comment "${workflow_files[@]}"; then
    status=1
  fi

  if ! zizmor --no-progress "${workflow_files[@]}"; then
    status=1
  fi
fi

if ((${#dockerfiles[@]} > 0)); then
  echo "Checking staged Dockerfiles..."

  if ! hadolint "${dockerfiles[@]}"; then
    status=1
  fi
fi

if ((${#toml_files[@]} > 0)); then
  echo "Checking staged TOML files..."

  if ! tombi lint "${toml_files[@]}"; then
    status=1
  fi

  if ! tombi format --check --diff "${toml_files[@]}"; then
    status=1
  fi
fi

exit "$status"
