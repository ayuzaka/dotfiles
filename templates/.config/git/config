[include]
  path = ~/.config/git/config.local
{% if vars.dotfiles_purpose == "work" %}
{{ read_file(path="private/git/work.gitconfig") }}
{% endif %}
[user]
  signingkey = ~/.ssh/id_git_sign
[core]
  editor = nvim
  pager = hunk pager
[gpg]
  format = ssh
[gpg "ssh"]
  program = ~/.local/bin/ssh-sign
[commit]
  verbose = true
  gpgsign = true
  template = ~/.config/git/gitmessage
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
[credential]
  helper = osxkeychain
[init]
  defaultBranch = main
[rerere]
  enabled = true
[fetch]
  prune = true
  pruneTags = true
[pull]
  rebase = true
[push]
  useForceIfIncludes = true
  autoSetupRemote = true
[mergetool]
  trustExitCode = true
 [diff]
  tool = difftastic
 [difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[pager]
  difftool = true
[tig]
  tab-size = 4
[ghq]
  vcs = git
  root = ~/workspace
[wt]
  basedir = .git-wt
  nocd = create
  copy = .env
  copy = .env.local
  copy = .envrc
  copy = .nvim.lua
  copy = .claude/settings.local.json
  hook = ~/.local/bin/wt-open-tab || true
[hook "protect-main"]
	event = pre-push
	command = ~/.config/git/hooks/pre-push
