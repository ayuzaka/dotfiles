#!/bin/bash
# Sync Ghostty theme fragment from ~/.config/theme (light|dark), then reload.
set -euo pipefail

theme_file="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
out_file="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/theme"

mode="dark"
if [[ -f "$theme_file" ]]; then
  mode="$(tr -d '[:space:]' <"$theme_file")"
fi

case "$mode" in
  light)
    ghostty_theme="Everforest Light Med"
    ;;
  *)
    ghostty_theme="Everforest Dark Hard"
    ;;
esac

mkdir -p "$(dirname "$out_file")"
tmp="$(mktemp "${out_file}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

cat >"$tmp" <<EOF
# Generated by ghostty-sync-theme from ~/.config/theme (${mode}).
# Do not edit by hand; rerun ghostty-sync-theme after changing the theme.
theme = ${ghostty_theme}
EOF

if [[ -f "$out_file" ]] && cmp -s "$tmp" "$out_file"; then
  echo "unchanged ${out_file} (theme = ${ghostty_theme})"
else
  mv -f "$tmp" "$out_file"
  trap - EXIT
  echo "wrote ${out_file} (theme = ${ghostty_theme})"
fi

# Reload running Ghostty without stealing focus.
if pgrep -qf 'Ghostty.app' >/dev/null 2>&1; then
  osascript <<'EOF' >/dev/null 2>&1 || true
tell application "Ghostty"
  if (count of windows) is 0 then return
  set t to focused terminal of selected tab of front window
  perform action "reload_config" on t
end tell
EOF
fi
