#!/bin/bash
# git-wt hook: open the new checkout as a herdr space (not a Ghostty tab).
set -uo pipefail

dir="$PWD"
[[ -d "$dir" ]] || exit 0

common_dir="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || exit 0
repo_root="$(dirname "$common_dir")"

# herdr server が居ないときは何もしない（hook は || true）
command -v herdr >/dev/null 2>&1 || exit 0
herdr status server >/dev/null 2>&1 || exit 0

out="$(herdr worktree open --cwd "$repo_root" --path "$dir" --focus 2>&1)" || exit 0
case "$out" in
  *\"error\"*) exit 0 ;;
esac

# herdr 外から git wt した場合は TUI を attach
if [[ "${HERDR_ENV:-}" != 1 ]]; then
  herdr
fi
