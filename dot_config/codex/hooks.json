{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.local/bin/guard-commands.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '~/.config/codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/codex/runcat-hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
